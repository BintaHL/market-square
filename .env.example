# Explicit fallback for a demo deployment when the authentication backend is
# unavailable. Set this only for deployments that are intended to expose demo access.
# DEMO_AUTH_ENABLED=true
# DEMO_ADMIN_USERNAME=admin
# DEMO_ADMIN_PASSWORD=admin123


# Required by live authentication and every server-side backend request.
# Set this in your hosting provider's deployment environment too; it is not
# exposed to browsers, so it must not use the NEXT_PUBLIC_ prefix.
API_URL=https://dummyjson.com
